<full-backup-content>
    <!-- Exclude SharedPreferences, Jetpack DataStore (Gemini API key & admin session), local DBs, and cached avatars -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
    <exclude domain="file" path="profile_images" />
    <exclude domain="database" path="." />
</full-backup-content>
