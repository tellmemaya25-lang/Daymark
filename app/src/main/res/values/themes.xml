<resources>
    <style name="Theme.Sabihon" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Android 12+ system splash (and the androidx compat shim below 12).

      Deliberately static: no icon animation timer, no spinner, no held condition.
      Android dismisses this when the first Compose frame is ready to draw, and that
      frame is the branded launch screen (`ui/launch/LaunchScreen.kt`) on the same
      charcoal - so the two read as one continuous launch surface rather than as two
      splashes in a row.

      The icon is the launcher icon itself, so the mark carried across the handover is
      the same one the user just tapped, and the Compose screen grows that mark rather
      than introducing a different logo.
    -->
    <style name="Theme.Sabihon.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/daymark_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Sabihon</item>
    </style>
</resources>
