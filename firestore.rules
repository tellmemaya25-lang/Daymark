rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPrimaryAdminEmail() {
      return isSignedIn() &&
        request.auth.token.get('email', '').lower() == 'tellmemaya25@gmail.com';
    }

    function isDelegatedAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('enabled', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        isPrimaryAdminEmail() ||
        isDelegatedAdmin()
      );
    }

    function validOptionalString(data, key, maxLen) {
      return !(key in data) ||
        data[key] == null ||
        (data[key] is string && data[key].size() <= maxLen);
    }

    function validUserPayload(data) {
      return validOptionalString(data, 'displayName', 120) &&
        validOptionalString(data, 'email', 254);
    }

    function validTaskPayload(taskId, data) {
      return taskId.size() <= 128 &&
        validOptionalString(data, 'title', 500) &&
        validOptionalString(data, 'description', 5000);
    }

    function validCategoryPayload(categoryId, data) {
      return categoryId.size() <= 128 &&
        validOptionalString(data, 'name', 120) &&
        validOptionalString(data, 'colorHex', 16);
    }

    // Prevents non-admin clients from self-assigning role="ADMIN" or clearing disabled=true,
    // while safely handling older /users/{uid} docs that predate `role` and `disabled`.
    function ownerUserWriteAllowed() {
      let incoming = request.resource.data;
      let nextRole = incoming.get('role', 'USER');
      let nextDisabled = incoming.get('disabled', false);
      let prevRole = resource == null ? 'USER' : resource.data.get('role', 'USER');
      let prevDisabled = resource == null ? false : resource.data.get('disabled', false);
      let roleSafe = (nextRole == prevRole) || isPrimaryAdminEmail();
      let disabledSafe = (nextDisabled == prevDisabled);
      return roleSafe && disabledSafe && validUserPayload(incoming);
    }

    // Users collection – owner can read/write own profile (non-privileged fields); admins have full governance CRUD.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) && ownerUserWriteAllowed()) ||
        (isAdmin() && validUserPayload(request.resource.data));
      allow delete: if isOwner(uid) || isAdmin();

      match /tasks/{taskId} {
        allow read, delete: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) &&
          validTaskPayload(taskId, request.resource.data);
      }

      match /categories/{categoryId} {
        allow read, delete: if isOwner(uid) || isAdmin();
        allow create, update: if (isOwner(uid) || isAdmin()) &&
          validCategoryPayload(categoryId, request.resource.data);
      }

      match /activity/{activityId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /{document=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Collection-group read/write rules for Admin Dashboard platform analytics & global task CRUD.
    match /{path=**}/tasks/{taskId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validTaskPayload(taskId, request.resource.data);
    }

    match /{path=**}/categories/{categoryId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && validCategoryPayload(categoryId, request.resource.data);
    }

    match /{path=**}/activity/{activityId} {
      allow read: if isAdmin();
    }

    // Delegated admin registry – users can check their own status; admins manage entries.
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Global runtime configuration & system announcement banner.
    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() &&
        validOptionalString(request.resource.data, 'announcementBanner', 500);
    }

    // Zero-PII aggregated daily AI telemetry counters (YYYY-MM-DD key guard).
    match /ai_telemetry_daily/{dayKey} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn() &&
        dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if false;
    }

    // Append-only immutable administrative audit trail.
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.get('action', '') is string &&
        request.resource.data.get('action', '').size() > 0 &&
        request.resource.data.get('action', '').size() <= 120 &&
        validOptionalString(request.resource.data, 'summary', 1000);
      allow update, delete: if false;
    }
  }
}
