rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isPrimaryAdminEmail() {
      return isSignedIn() &&
        request.auth.token.get('email', '').lower() == 'tellmemaya25@gmail.com';
    }

    function isDelegatedAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('enabled', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        isPrimaryAdminEmail() ||
        isDelegatedAdmin()
      );
    }

    // Prevents non-admin clients from self-assigning role="ADMIN" or clearing disabled=true,
    // while safely handling older /users/{uid} docs that predate `role` and `disabled`.
    function ownerUserWriteAllowed() {
      let incoming = request.resource.data;
      let nextRole = incoming.get('role', 'USER');
      let nextDisabled = incoming.get('disabled', false);
      let prevRole = resource == null ? 'USER' : resource.data.get('role', 'USER');
      let prevDisabled = resource == null ? false : resource.data.get('disabled', false);
      let roleSafe = (nextRole == prevRole) || isPrimaryAdminEmail();
      let disabledSafe = (nextDisabled == prevDisabled);
      return roleSafe && disabledSafe;
    }

    // Users collection – owner can read/write own profile (non-privileged fields); admins have full governance CRUD.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) && ownerUserWriteAllowed()) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      match /tasks/{taskId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /activity/{activityId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /{document=**} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Collection-group read/write rules for Admin Dashboard platform analytics & global task CRUD.
    match /{path=**}/tasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /{path=**}/categories/{categoryId} {
      allow read, write: if isAdmin();
    }

    match /{path=**}/activity/{activityId} {
      allow read: if isAdmin();
    }

    // Delegated admin registry – users can check their own status; admins manage entries.
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Global runtime configuration & system announcement banner.
    match /system_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Zero-PII aggregated daily AI telemetry counters.
    match /ai_telemetry_daily/{dayKey} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Append-only immutable administrative audit trail.
    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
